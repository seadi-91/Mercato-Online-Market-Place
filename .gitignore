# ==============================================================================
# MercatoX - Root Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 2. Build Outputs & Compilations
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
.vercel/
**/.vercel/
.turbo/
**/.turbo/
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/

# ------------------------------------------------------------------------------
# 3. TypeScript Caches
# ------------------------------------------------------------------------------
*.tsbuildinfo
**/*.tsbuildinfo
tsconfig.tsbuildinfo
client/tsconfig.tsbuildinfo
server/tsconfig.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production

# Keep example templates committed
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Secret keys & certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 5. Logs & Runtime Diagnostic Output
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. Temporary Files & Local Uploads
# ------------------------------------------------------------------------------
tmp/
**/tmp/
temp/
**/temp/
uploads/
**/uploads/
storage/
**/storage/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 7. Local Database & SQLite Files
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-journal
*.dump

# ------------------------------------------------------------------------------
# 8. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
playwright-report/
**/playwright-report/
test-results/
**/test-results/

# ------------------------------------------------------------------------------
# 9. Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
**/.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
**/Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Editors & IDEs
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

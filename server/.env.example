# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here

AUTH_DB_NAME=mercatox_auth_db
USERS_DB_NAME=mercatox_users_db
CATALOG_DB_NAME=mercatox_catalog_db
ORDERS_DB_NAME=mercatox_order_db
PAYMENTS_DB_NAME=mercatox_payment_db
DB_SYNCHRONIZE=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=7d

# Microservice TCP Configuration
AUTH_TCP_HOST=127.0.0.1
AUTH_TCP_PORT=4001
USERS_TCP_HOST=127.0.0.1
USERS_TCP_PORT=4002
CATALOG_TCP_HOST=127.0.0.1
CATALOG_TCP_PORT=4003
ORDERS_TCP_HOST=127.0.0.1
ORDERS_TCP_PORT=4004
PAYMENTS_TCP_HOST=127.0.0.1
PAYMENTS_TCP_PORT=4005
API_GATEWAY_PORT=3001

# Chapa Payment Gateway
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your_chapa_public_key
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key
CHAPA_ENCRYPTION_KEY=your_chapa_encryption_key
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:3000/payments/webhook/chapa

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMTP Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM=MercatoX@marketplace.com

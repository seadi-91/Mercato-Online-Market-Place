# ==============================================================================
# MercatoX - Backend Server .gitignore
# ==============================================================================

# Compiled output
/dist
dist/
/build
build/

# Node dependencies
/node_modules
node_modules/
.pnp
.pnp.js

# Environment files & Secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
!.env.*.example

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Temporary files & uploads
uploads/
tmp/
temp/
*.sqlite
*.sqlite3

# OS & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# TypeScript cache
*.tsbuildinfo
tsconfig.tsbuildinfo
